  "dependencies": {
    "@nt/core": "workspace:*",
    "@nt/db": "workspace:*"
  },
  "devDependencies": {
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "tsx": "^4.19.2",
    "@types/better-sqlite3": "^7.6.12"
  }
}
