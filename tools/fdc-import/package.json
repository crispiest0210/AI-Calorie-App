{
  "name": "@nt/fdc-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch:usda": "node src/fetch-usda.mjs",
    "fetch:off": "node src/fetch-off.mjs",
